rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function for admin check
    function isAdmin() {
      return request.auth != null;
    }

    // Public catalog: brands
    match /brands/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public catalog: flavors
    match /flavors/{doc} {
      allow read: if true;
      // Allow admin full write; allow public stock updates during valid non-negative transactions
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock >= 0
      );
    }

    // Inventory mirror
    match /inventory/{doc} {
      allow read: if true;
      allow write: if true;
    }

    // Customer reward tracker
    match /customers/{doc} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Allow admin full update, or customer reward claim counter updates
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalRedeemed', 'claimableRewards', 'rewardProgress', 'items', 'totalPurchased'])
      );
    }

    // Sales records: admin only
    match /sales/{doc} {
      allow read, write: if isAdmin();
    }

    // Claims records: public can create a claim voucher of 1 pod; only admin can modify/delete
    match /claims/{doc} {
      allow read: if true;
      allow create: if request.resource.data.quantity == 1;
      allow update, delete: if isAdmin();
    }

    // Shop settings: public read, admin write
    match /settings/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Spin tickets collection for Roulette
    match /spinTickets/{doc} {
      allow read: if true;
      // Only authenticated admin can issue or delete spin tickets
      allow create, delete: if isAdmin();
      // Public updates are strictly allowed only on pending tickets to progress stages or claim
      allow update: if isAdmin() || (
        resource.data.status == "pending" &&
        request.resource.data.code == resource.data.code &&
        request.resource.data.customerId == resource.data.customerId
      );
    }

    // Admin whitelist collection
    match /admins/{email} {
      allow read: if isAdmin();
      allow write: if false;
    }
  }
}
