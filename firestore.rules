rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Public catalog and customer reward tracker.
    match /brands/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /flavors/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /inventory/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /customers/{doc} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Operational and admin data.
    match /sales/{doc} {
      allow read, write: if request.auth != null;
    }

    match /claims/{doc} {
      allow read, write: if request.auth != null;
    }

    match /settings/{doc} {
      allow read, write: if request.auth != null;
    }

    match /admins/{email} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
